VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-anon-key

# Reaching the app from a phone over Tailscale (`npm run dev:tailscale`):
# create web/.env.tailscale — gitignored, so your tailnet address stays private —
# containing only the line below, pointing at the machine running Docker
# (`tailscale ip -4` on that machine). The anon key is still read from .env.
#
#   VITE_SUPABASE_URL=http://100.x.y.z:54321
#
# It has to be the tailnet address rather than loopback because the request is
# made by the phone's browser, not by the dev server.
